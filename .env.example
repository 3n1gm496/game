# ─────────────────────────────────────────────────────────────────────────────
# MÉRIDIEN · variabili d'ambiente del SERVER
#
# Copia questo file in `.env` e riempi solo ciò che ti serve.
# Con l'ambiente vuoto il gioco funziona completamente: il Regista usa il
# provider deterministico e non serve nessuna chiave.
#
# NESSUNA di queste variabili viene mai esposta al client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Rete ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Cartella della build statica del client, relativa alla directory di lavoro
# del server. Se non esiste, il server fa solo da API.
STATIC_DIR=../web/dist

# Origini ammesse, separate da virgola. Vuoto = stessa origine.
ALLOWED_ORIGINS=

# ── Stanze ──────────────────────────────────────────────────────────────────
ROOM_IDLE_MINUTES=20
ROOM_MAX_HOURS=3
MAX_ROOMS=500

# ── Regista AI ──────────────────────────────────────────────────────────────
# deterministic  → nessuna rete, nessuna chiave. È il valore predefinito.
# anthropic      → richiede ANTHROPIC_API_KEY
# openai-compatible → richiede MERIDIEN_AI_BASE_URL (vLLM, Ollama, llama.cpp…)
MERIDIEN_AI_PROVIDER=deterministic

# false disattiva il provider esterno lasciando la configurazione al suo posto
MERIDIEN_AI_ENABLED=true
MERIDIEN_AI_TIMEOUT_MS=6000

# Facoltativi, secondo il provider scelto
MERIDIEN_AI_MODEL=
MERIDIEN_AI_BASE_URL=
MERIDIEN_AI_API_KEY=

# Solo per il provider anthropic. Non commettere mai questo valore.
ANTHROPIC_API_KEY=

# ── Osservabilità ───────────────────────────────────────────────────────────
LOG_LEVEL=info

# Se valorizzato, /metrics richiede ?token=<valore>
METRICS_TOKEN=

# Raccolta anonima: disattivata per impostazione predefinita, per scelta.
ANALYTICS_ENABLED=false

# ── Pubblicazione ───────────────────────────────────────────────────────────
# Vuoto = `pnpm deploy:*` costruisce e verifica, poi spiega cosa manca.
# fly | render | docker
MERIDIEN_DEPLOY_PROVIDER=

# fly
FLY_API_TOKEN=

# render
RENDER_API_KEY=
RENDER_SERVICE_ID=

# docker
MERIDIEN_REGISTRY=
MERIDIEN_REGISTRY_USER=
MERIDIEN_REGISTRY_PASSWORD=
